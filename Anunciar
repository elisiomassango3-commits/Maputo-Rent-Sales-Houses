<!-- ===== HERO DA PÁGINA ===== -->
<section class="page-hero">
  <div class="container">
    <p class="eyebrow eyebrow-light">Anunciar imóvel</p>
    <h1>Coloque o seu imóvel à frente de milhares de pessoas</h1>
    <p>Escolha um plano, preencha os dados do imóvel e ative o anúncio pagando pelo método que preferir.</p>

    <div class="steps">
      <div class="step is-active"><span>1</span> Escolher plano</div>
      <div class="step"><span>2</span> Dados do imóvel</div>
      <div class="step"><span>3</span> Pagamento</div>
    </div>
  </div>
</section>

<!-- ===== PLANOS ===== -->
<section class="section" id="planos">
  <div class="container">
    <div class="section-head">
      <div>
        <p class="eyebrow">Planos de anúncio</p>
        <h2>Escolha como quer destacar o seu imóvel</h2>
      </div>
      <p class="section-head-note">Todos os planos ficam ativos por 30 dias. Pode renovar ou mudar de plano quando quiser.</p>
    </div>

    <form id="planForm">
      <div class="plans-grid">

        <label class="plan-card" data-plan-card>
          <input type="radio" name="plano" value="basico" data-price="500" style="display:none">
          <p class="plan-name">Básico</p>
          <p class="plan-price">500 MT <small>/ 30 dias</small></p>
          <p class="plan-duration">Ideal para começar a anunciar</p>
          <ul class="plan-features">
            <li><i class="fa-solid fa-check"></i> Até 5 fotos do imóvel</li>
            <li><i class="fa-solid fa-check"></i> Aparece na listagem geral</li>
            <li><i class="fa-solid fa-check"></i> Contacto direto por WhatsApp</li>
          </ul>
          <span class="plan-select">Escolher Básico</span>
        </label>

        <label class="plan-card" data-plan-card>
          <input type="radio" name="plano" value="destaque" data-price="1500" style="display:none">
          <span class="plan-badge">Mais escolhido</span>
          <p class="plan-name">Destaque</p>
          <p class="plan-price">1.500 MT <small>/ 30 dias</small></p>
          <p class="plan-duration">Para vender ou alugar mais rápido</p>
          <ul class="plan-features">
            <li><i class="fa-solid fa-check"></i> Até 15 fotos do imóvel</li>
            <li><i class="fa-solid fa-check"></i> Selo "Destaque" no anúncio</li>
            <li><i class="fa-solid fa-check"></i> Aparece no topo da categoria</li>
            <li><i class="fa-solid fa-check"></i> Contacto direto por WhatsApp</li>
          </ul>
          <span class="plan-select">Escolher Destaque</span>
        </label>

        <label class="plan-card" data-plan-card>
          <input type="radio" name="plano" value="premium" data-price="3000" style="display:none">
          <p class="plan-name">Premium</p>
          <p class="plan-price">3.000 MT <small>/ 30 dias</small></p>
          <p class="plan-duration">Máxima visibilidade</p>
          <ul class="plan-features">
            <li><i class="fa-solid fa-check"></i> Fotos ilimitadas + vídeo</li>
            <li><i class="fa-solid fa-check"></i> Selo "Premium" no anúncio</li>
            <li><i class="fa-solid fa-check"></i> Destaque na página inicial</li>
            <li><i class="fa-solid fa-check"></i> Suporte prioritário</li>
          </ul>
          <span class="plan-select">Escolher Premium</span>
        </label>

      </div>
    </form>
  </div>
</section>

<!-- ===== CHECKOUT / PAGAMENTO ===== -->
<section class="section section-muted" id="pagamento">
  <div class="container">
    <div class="section-head">
      <div>
        <p class="eyebrow">Pagamento</p>
        <h2>Finalize o seu anúncio</h2>
      </div>
    </div>

    <div class="checkout">

      <!-- Coluna esquerda: dados do imóvel + pagamento -->
      <div>
        <div class="checkout-panel" style="margin-bottom:22px;">
          <h3>Dados do imóvel</h3>
          <div class="field-row">
            <div class="field-group">
              <label for="titulo">Título do anúncio</label>
              <input type="text" id="titulo" placeholder="Ex: Apartamento T3 – Sommerschield">
            </div>
            <div class="field-group">
              <label for="tipoImovel">Tipo de imóvel</label>
              <select id="tipoImovel">
                <option>Apartamento</option>
                <option>Casa</option>
                <option>Escritório</option>
                <option>Loja</option>
                <option>Terreno</option>
              </select>
            </div>
          </div>
          <div class="field-row">
            <div class="field-group">
              <label for="finalidade">Finalidade</label>
              <select id="finalidade">
                <option>Para alugar</option>
                <option>Para vender</option>
              </select>
            </div>
            <div class="field-group">
              <label for="bairroImovel">Bairro</label>
              <input type="text" id="bairroImovel" placeholder="Ex: Sommerschield, Maputo">
            </div>
          </div>
          <div class="field-group">
            <label for="fotosImovel">Fotos do imóvel</label>
            <div class="file-drop">
              <i class="fa-solid fa-camera"></i>
              Clique ou arraste as fotos do imóvel para aqui
            </div>
          </div>
        </div>

        <div class="checkout-panel">
          <h3>Método de pagamento</h3>

          <div class="payment-methods" id="paymentMethods">
            <label class="payment-method" data-method="mpesa">
              <input type="radio" name="metodo" value="mpesa" style="display:none">
              <i class="fa-solid fa-mobile-screen-button"></i>
              <span>M-Pesa</span>
            </label>
            <label class="payment-method" data-method="emola">
              <input type="radio" name="metodo" value="emola" style="display:none">
              <i class="fa-solid fa-mobile-screen-button"></i>
              <span>e-Mola</span>
            </label>
            <label class="payment-method" data-method="banco">
              <input type="radio" name="metodo" value="banco" style="display:none">
              <i class="fa-solid fa-building-columns"></i>
              <span>Transferência</span>
            </label>
            <label class="payment-method" data-method="cartao">
              <input type="radio" name="metodo" value="cartao" style="display:none">
              <i class="fa-regular fa-credit-card"></i>
              <span>Cartão</span>
            </label>
          </div>

          <!-- M-Pesa -->
          <div class="payment-fields" data-fields="mpesa">
            <div class="field-group">
              <label for="mpesaNumero">Número M-Pesa</label>
              <input type="tel" id="mpesaNumero" placeholder="84 ou 85 xxx xxxx">
              <p class="field-hint">Vai receber um pedido de confirmação (PIN) no seu telemóvel para autorizar o pagamento.</p>
            </div>
          </div>

          <!-- e-Mola -->
          <div class="payment-fields" data-fields="emola">
            <div class="field-group">
              <label for="emolaNumero">Número e-Mola</label>
              <input type="tel" id="emolaNumero" placeholder="86 ou 87 xxx xxxx">
              <p class="field-hint">Vai receber um pedido de confirmação (PIN) no seu telemóvel para autorizar o pagamento.</p>
            </div>
          </div>

          <!-- Transferência bancária -->
          <div class="payment-fields" data-fields="banco">
            <div class="bank-details">
              <dl>
                <dt>Banco</dt><dd>[Nome do banco]</dd>
                <dt>Titular</dt><dd>Maputo Rent &amp; Sales, Lda</dd>
                <dt>NIB</dt><dd>[0000 0000 0000 0000 0000 0]</dd>
                <dt>Referência</dt><dd id="refBanco">—</dd>
              </dl>
            </div>
            <div class="field-group">
              <label for="comprovativo">Comprovativo de transferência</label>
              <div class="file-drop">
                <i class="fa-solid fa-file-arrow-up"></i>
                Clique para carregar o comprovativo (PDF ou imagem)
              </div>
            </div>
          </div>

          <!-- Cartão -->
          <div class="payment-fields" data-fields="cartao">
            <div class="field-group">
              <label for="cardName">Nome no cartão</label>
              <input type="text" id="cardName" placeholder="Como está impresso no cartão">
            </div>
            <div class="field-group">
              <label for="cardNumber">Número do cartão</label>
              <input type="text" id="cardNumber" inputmode="numeric" placeholder="0000 0000 0000 0000">
            </div>
            <div class="field-row">
              <div class="field-group">
                <label for="cardExpiry">Validade</label>
                <input type="text" id="cardExpiry" placeholder="MM/AA">
              </div>
              <div class="field-group">
                <label for="cardCvv">CVV</label>
                <input type="text" id="cardCvv" inputmode="numeric" placeholder="123">
              </div>
            </div>
          </div>

          <p class="field-hint" id="noMethodHint">Selecione um método de pagamento acima para continuar.</p>
        </div>
      </div>

      <!-- Coluna direita: resumo -->
      <div class="summary-panel">
        <h3>Resumo do pedido</h3>
        <div class="summary-row">
          <span>Plano escolhido</span>
          <span id="summaryPlan">—</span>
        </div>
        <div class="summary-row">
          <span>Duração</span>
          <span>30 dias</span>
        </div>
        <div class="summary-row total">
          <span>Total a pagar</span>
          <span id="summaryTotal">0 MT</span>
        </div>

        <button type="button" class="btn btn-dark checkout-submit" id="confirmPayment">
          Confirmar pagamento <i class="fa-solid fa-arrow-right"></i>
        </button>

        <p class="summary-note"><i class="fa-solid fa-lock"></i> O seu anúncio fica visível assim que o pagamento for confirmado.</p>
      </div>

    </div>
  </div>
</section>

